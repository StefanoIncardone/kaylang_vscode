{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "Kay",
 "scopeName": "source.kay",
 "fileTypes": [".kay"],
 "patterns": [
  { "include": "#comment" },
  { "include": "#non_ascii" },
  { "include": "#bracket" },
  { "include": "#colon" },
  { "include": "#semicolon" },
  { "include": "#comma" },
  { "include": "#keyword" },
  { "include": "#literal" },
  { "include": "#identifier" }
 ],
 "repository": {
  "comment.block": {
   "name": "comment.block.kay",
   "begin": "##",
   "end": "##"
  },
  "comment.line": {
   "name": "comment.line.number-sign.kay",
   "begin": "#",
   "end": "\\n"
  },
  "comment": {
   "patterns": [
    { "include": "#comment.block" },
    { "include": "#comment.line" }
   ]
  },

  "non_ascii": {
   "name": "invalid.illegal.non_ascii.kay",
   "match": "[^\\x00-\\x7f]"
  },

  "bracket": {
   "name": "entity.other.bracket.kay",
   "match": "[(\\[{)\\]}]"
  },
  "colon": {
   "name": "entity.other.colon.kay",
   "match": ":"
  },
  "semicolon": {
   "name": "entity.other.semicolon.kay",
   "match": ";"
  },
  "comma": {
   "name": "entity.other.comma.kay",
   "match": ","
  },

  "keyword.operator.equals_equals": {
   "name": "keyword.operator.equals_equals.kay",
   "match": "=="
  },
  "keyword.operator.equals": {
   "name": "keyword.operator.equals.kay",
   "match": "="
  },
  "keyword.operator.not_equals": {
   "name": "keyword.operator.not_equals.kay",
   "match": "!="
  },
  "keyword.operator.not": {
   "name": "keyword.operator.not.kay",
   "match": "!"
  },
  "keyword.operator.len": {
   "name": "keyword.operator.new.len.kay",
   "match": "\\b(?:len)\\b"
  },
  "keyword.operator.pow": {
   "name": "keyword.operator.pow.kay",
   "match": "\\*\\*(?:\\\\|\\|)?=?"
  },
  "keyword.operator.times": {
   "name": "keyword.operator.times.kay",
   "match": "\\*(?:\\\\|\\|)?=?"
  },
  "keyword.operator.divide": {
   "name": "keyword.operator.divide.kay",
   "match": "/(?:\\\\|\\|)?=?"
  },
  "keyword.operator.remainder": {
   "name": "keyword.operator.remainder.kay",
   "match": "%=?"
  },
  "keyword.operator.plus": {
   "name": "keyword.operator.plus.kay",
   "match": "\\+(?:\\\\|\\|)?=?"
  },
  "keyword.operator.minus": {
   "name": "keyword.operator.minus.kay",
   "match": "-(?:\\\\|\\|)?=?"
  },
  "keyword.operator.left_rotate": {
   "name": "keyword.operator.left_rotate.kay",
   "match": "<<<=?"
  },
  "keyword.operator.right_rotate": {
   "name": "keyword.operator.right_rotate.kay",
   "match": ">>>=?"
  },
  "keyword.operator.left_shift": {
   "name": "keyword.operator.left_shift.kay",
   "match": "<<(?:\\\\|\\|)?=?"
  },
  "keyword.operator.right_shift": {
   "name": "keyword.operator.right_shift.kay",
   "match": ">>=?"
  },
  "keyword.operator.greater": {
   "name": "keyword.operator.greater.kay",
   "match": ">=?"
  },
  "keyword.operator.less": {
   "name": "keyword.operator.less.kay",
   "match": "<=?"
  },
  "keyword.operator.compare": {
   "name": "keyword.operator.compare.kay",
   "match": "<=>"
  },
  "keyword.operator.and": {
   "name": "keyword.operator.and.kay",
   "match": "&&=?"
  },
  "keyword.operator.or": {
   "name": "keyword.operator.or.kay",
   "match": "\\|\\|=?"
  },
  "keyword.operator.bit_and": {
   "name": "keyword.operator.bit_and.kay",
   "match": "&=?"
  },
  "keyword.operator.bit_or": {
   "name": "keyword.operator.bit_or.kay",
   "match": "\\|=?"
  },
  "keyword.operator.bit_xor": {
   "name": "keyword.operator.bit_xor.kay",
   "match": "\\^=?"
  },
  "keyword.operator": {
   "patterns": [
    { "include": "#keyword.operator.equals_equals" },
    { "include": "#keyword.operator.equals" },
    { "include": "#keyword.operator.not_equals" },
    { "include": "#keyword.operator.not" },
    { "include": "#keyword.operator.len" },
    { "include": "#keyword.operator.pow" },
    { "include": "#keyword.operator.times" },
    { "include": "#keyword.operator.divide" },
    { "include": "#keyword.operator.remainder" },
    { "include": "#keyword.operator.plus" },
    { "include": "#keyword.operator.minus" },
    { "include": "#keyword.operator.left_rotate" },
    { "include": "#keyword.operator.right_rotate" },
    { "include": "#keyword.operator.left_shift" },
    { "include": "#keyword.operator.right_shift" },
    { "include": "#keyword.operator.greater" },
    { "include": "#keyword.operator.less" },
    { "include": "#keyword.operator.compare" },
    { "include": "#keyword.operator.and" },
    { "include": "#keyword.operator.or" },
    { "include": "#keyword.operator.bit_and" },
    { "include": "#keyword.operator.bit_or" },
    { "include": "#keyword.operator.bit_xor" }
   ]
  },

  "keyword.control_flow": {
   "name": "keyword.control.kay",
   "match": "\\b(?:do|if|else|loop|break|continue)\\b"
  },
  "keyword.storage_modifier": {
   "name": "storage.modifier.kay",
   "match": "\\b(?:let|var)\\b"
  },
  "keyword.builtin_function": {
   "name": "support.function.kay",
   "match": "\\b(?:print|println|eprint|eprintln)\\b"
  },
  "keyword": {
   "patterns": [
    { "include": "#keyword.operator" },
    { "include": "#keyword.control_flow" },
    { "include": "#keyword.storage_modifier" },
    { "include": "#keyword.builtin_function" }
   ]
  },

  "escape.backslash": {
   "name": "constant.character.escape.backslash.kay",
   "match": "\\\\{2}"
  },
  "escape.single_quote": {
   "name": "constant.character.escape.single_quote.kay",
   "match": "\\\\'"
  },
  "escape.double_quote": {
   "name": "constant.character.escape.double_quote.kay",
   "match": "\\\\\""
  },
  "escape.newline": {
   "name": "constant.character.escape.newline.kay",
   "match": "\\\\n"
  },
  "escape.carriage_return": {
   "name": "constant.character.escape.carriage_return.kay",
   "match": "\\\\r"
  },
  "escape.tab": {
   "name": "constant.character.escape.tab.kay",
   "match": "\\\\t"
  },
  "escape.null": {
   "name": "constant.character.escape.null.kay",
   "match": "\\\\0"
  },
  "escape.unrecognized": {
   "name": "invalid.illegal.escape.kay",
   "match": "\\\\."
  },
  "escape": {
   "patterns": [
    { "include": "#escape.backslash" },
    { "include": "#escape.single_quote" },
    { "include": "#escape.double_quote" },
    { "include": "#escape.newline" },
    { "include": "#escape.carriage_return" },
    { "include": "#escape.tab" },
    { "include": "#escape.null" },
    { "include": "#escape.unrecognized" }
   ]
  },

  "literal.boolean": {
   "name": "constant.language.boolean.kay",
   "match": "\\b(?:true|false)\\b"
  },

  "literal.character.empty": {
   "name": "string.quoted.single.kay invalid.illegal.empty.kay",
   "match": "''"
  },
  "literal.character.long": {
   "name": "string.quoted.single.kay invalid.illegal.long.kay",
   "match": "'((?:\\\\.|[^'\\\\]){2,})'",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.character.valid": {
   "name": "string.quoted.single.kay",
   "match": "'((?:\\\\.|[^'\\\\]))'",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.character.unclosed": {
   "name": "string.quoted.single.kay invalid.illegal.unclosed.kay",
   "match": "'((?:\\\\.|[^'\\\\])*)",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.character": {
   "patterns": [
    { "include": "#literal.character.empty" },
    { "include": "#literal.character.long" },
    { "include": "#literal.character.valid" },
    { "include": "#literal.character.unclosed" }
   ]
  },

  "literal.string.valid": {
   "name": "string.quoted.double.kay",
   "match": "\"((?:\\\\.|[^\"\\\\])*)\"",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.string.unclosed": {
   "name": "string.quoted.double.kay invalid.illegal.unclosed.kay",
   "match": "\"((?:\\\\.|[^\"\\\\])*)",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#escape" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.string": {
   "patterns": [
    { "include": "#literal.string.valid" },
    { "include": "#literal.string.unclosed" }
   ]
  },

  "literal.raw_string.valid": {
   "name": "string.quoted.double.raw.kay",
   "match": "(r)\"((?:\\\\(?=[^\"])|\\\\\"|[^\"\\\\])*)\"",
   "captures": {
    "1": { "name": "markup.changed.prefix.kay" },
    "2": {
     "patterns": [
      { "include": "#escape.double_quote" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.raw_string.unclosed": {
   "name": "string.quoted.double.raw.kay invalid.illegal.unclosed.kay",
   "match": "(r)\"((?:\\\\(?=[^\"])|\\\\\"|[^\"\\\\])*)",
   "captures": {
    "1": { "name": "markup.changed.prefix.kay" },
    "2": {
     "patterns": [
      { "include": "#escape.double_quote" },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.raw_string": {
   "patterns": [
    { "include": "#literal.raw_string.valid" },
    { "include": "#literal.raw_string.unclosed" }
   ]
  },

  "literal.integer.binary": {
   "name": "constant.numeric.integer.binary.kay",
   "match": "(0(b))((?:[A-Za-z\\d_]|[^\\x00-\\x7f])*)",
   "captures": {
    "1": { "name": "constant.numeric.integer.prefix.kay" },
    "2": { "name": "constant.numeric.integer.base.kay markup.changed.kay" },
    "3": {
     "patterns": [
      {
       "name": "invalid.illegal.digit.kay",
       "match": "[2-9]"
      },
      {
       "name": "invalid.illegal.letter.kay",
       "match": "[A-Za-z]"
      },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.integer.octal": {
   "name": "constant.numeric.integer.octal.kay",
   "match": "(0(o))((?:[A-Za-z\\d_]|[^\\x00-\\x7f])*)",
   "captures": {
    "1": { "name": "constant.numeric.integer.prefix.kay" },
    "2": { "name": "constant.numeric.integer.base.kay markup.changed.kay" },
    "3": {
     "patterns": [
      {
       "name": "invalid.illegal.digit.kay",
       "match": "[8-9]"
      },
      {
       "name": "invalid.illegal.letter.kay",
       "match": "[A-Za-z]"
      },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.integer.hexadecimal": {
   "name": "constant.numeric.integer.hexadecimal.kay",
   "match": "(0(x))((?:[A-Za-z\\d_]|[^\\x00-\\x7f])*)",
   "captures": {
    "1": { "name": "constant.numeric.integer.prefix.kay" },
    "2": { "name": "constant.numeric.integer.base.kay markup.changed.kay" },
    "3": {
     "patterns": [
      {
       "name": "invalid.illegal.digit.kay",
       "match": "[G-Zg-z]"
      },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.integer.decimal": {
   "name": "constant.numeric.integer.decimal.kay",
   "match": "(\\d(?:[A-Za-z\\d_]|[^\\x00-\\x7f])*)",
   "captures": {
    "1": {
     "patterns": [
      {
       "name": "invalid.illegal.letter.kay",
       "match": "[A-Za-z]"
      },
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "literal.integer": {
   "patterns": [
    { "include": "#literal.integer.binary" },
    { "include": "#literal.integer.octal" },
    { "include": "#literal.integer.hexadecimal" },
    { "include": "#literal.integer.decimal" }
   ]
  },

  "literal": {
   "patterns": [
    { "include": "#literal.boolean" },
    { "include": "#literal.character" },
    { "include": "#literal.string" },
    { "include": "#literal.raw_string" },
    { "include": "#literal.integer" }
   ]
  },

  "identifier.builtin_type": {
   "name": "entity.name.type",
   "match": "\\b(?:i64|ascii|bool|str)\\b"
  },
  "identifier.regular": {
   "name": "variable.name.kay",
   "match": "([A-Za-z_](?:[A-Za-z\\d_]|[^\\x00-\\x7f])*)",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "identifier.string": {
   "name": "string.quoted.other.kay variable.name.kay",
   "match": "`((?:[^`])*)`",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "identifier.string.unclosed": {
   "name": "string.quoted.other.kay variable.name.kay invalid.illegal.unclosed.kay",
   "match": "`((?:[^`])*)",
   "captures": {
    "1": {
     "patterns": [
      { "include": "#non_ascii" }
     ]
    }
   }
  },
  "identifier": {
   "patterns": [
    { "include": "#identifier.builtin_type" },
    { "include": "#identifier.regular" },
    { "include": "#identifier.string" },
    { "include": "#identifier.string.unclosed" }
   ]
  }
 }
}

{
 "name": "kay-lang",
 "displayName": "Kay Lang",
 "version": "0.1.5-dev",
 "author": { "name": "Stefano Incardone" },
 "categories": ["Programming Languages"],
 "description": "Syntax highlighting for Kay Lang",
 "repository": { "type": "git", "url": "https://github.com/StefanoIncardone/kaylang_vscode" },
 "license": "MIT",
 "engines": { "vscode": "^1.102.1" },

 "contributes": {
  "languages": [
   {
    "id": "kay",
    "aliases": ["Kay", "kay"],
    "extensions": [".kay"],
    "configuration": "./kay_language-configuration.json"
   },
   {
    "id": "kay-markdown-injection"
   }
  ],
  "grammars": [
   {
    "language": "kay",
    "scopeName": "source.kay",
    "path": "./kay_syntax.tmLanguage.json"
   },
   {
    "language": "kay-markdown-injection",
    "scopeName": "markdown.kay.codeblock",
    "path": "./kay_markdown-injection.tmLanguage.json",
    "injectTo": ["text.html.markdown"],
    "embeddedLanguages": {
     "meta.embedded.block.kay": "kay"
    }
   }
  ]
 }
}

{
 "comments": {
  "lineComment": "#",
  "blockComment": ["##", "##"],
 },
 "brackets": [
  ["{", "}"],
  ["[", "]"],
  ["(", ")"]
 ],
 "autoClosingPairs": [
  { "open": "##",  "close": " ##", "notIn": ["string"] },
  { "open": "{",   "close": "}",   "notIn": ["string"] },
  { "open": "[",   "close": "]",   "notIn": ["string"] },
  { "open": "(",   "close": ")",   "notIn": ["string"] },
  { "open": "\"",  "close": "\"",  "notIn": ["string", "comment"] },
  { "open": "r\"", "close": "\"",  "notIn": ["string", "comment"] },
  { "open": "'",   "close": "'",   "notIn": ["string", "comment"] },
  { "open": "`",   "close": "`",   "notIn": ["string", "comment"] },
 ],
 "surroundingPairs": [
  { "open": "{",  "close": "}" },
  { "open": "[",  "close": "]" },
  { "open": "(",  "close": ")" },
  { "open": "\"", "close": "\"" },
  { "open": "'",  "close": "'" },
  { "open": "`",  "close": "`" },
 ],
}
